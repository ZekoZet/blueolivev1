---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ExplainSection from '../components/ExplainSection.astro';
import BentoSection from '../components/BentoSection.astro';
import GlobeSection from '../components/GlobeSection.astro';
import ProjectCheck from '../components/ProjectCheck.astro';
import IndustriesSection from '../components/IndustriesSection.astro';
import PricingSection from '../components/PricingSection.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaSection from '../components/CtaSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
---

<BaseLayout path="/" intro>
  <Hero />
  <ExplainSection />
  <BentoSection />
  <GlobeSection />
  <ProjectCheck />
  <IndustriesSection />
  <PricingSection />
  <FaqSection />
  <CtaSection />
  <ServicesSection />
</BaseLayout>
