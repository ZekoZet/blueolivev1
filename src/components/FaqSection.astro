---
import Words from './Words.astro';
import Icon from './Icon.astro';
import { faq } from '../data/site';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
---

<section id="faq" class="on-dark relative bg-ink pb-20 md:pb-28">
  <div class="container-page max-w-4xl">
    <h2 class="h2 text-center" data-anim="words"><Words text={faq.title} /></h2>
    <div class="mt-10 space-y-3" data-anim="stagger" style="--delay:250ms;--step:110ms">
      {
        faq.items.map((item, i) => (
          <details class="faq card-dark group !rounded-2xl" open={i === 0}>
            <summary class="flex min-h-14 cursor-pointer list-none items-center gap-4 px-5 py-4 text-[0.95rem] font-semibold [&::-webkit-details-marker]:hidden">
              <Icon name="chevron-down" size={18} class="shrink-0 text-olive-bright transition-transform duration-300 group-open:rotate-180" />
              {item.q}
            </summary>
            <p class="px-5 pb-5 pl-[3.25rem] text-sm leading-relaxed text-paper-soft">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</section>
