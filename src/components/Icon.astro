---
// Line-Icons (Stroke 1.6), eigene Zeichnungen
export type IconName =
  | 'arrow-right'
  | 'arrow-up'
  | 'chevron-down'
  | 'chevron-left'
  | 'chevron-right'
  | 'check'
  | 'close'
  | 'sparkle'
  | 'layers'
  | 'code'
  | 'gauge'
  | 'pen'
  | 'eye'
  | 'wave'
  | 'grid'
  | 'devices'
  | 'map-pin'
  | 'mail'
  | 'chat'
  | 'rocket'
  | 'refresh'
  | 'target'
  | 'shield'
  | 'wrench'
  | 'palette'
  | 'utensils'
  | 'hammer'
  | 'home'
  | 'camera'
  | 'bag'
  | 'bolt';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 20, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow-right' && <path d="M5 12h14m-6-6 6 6-6 6" />}
  {name === 'arrow-up' && <path d="M12 19V5m-6 6 6-6 6 6" />}
  {name === 'chevron-down' && <path d="m6 9 6 6 6-6" />}
  {name === 'chevron-left' && <path d="m15 6-6 6 6 6" />}
  {name === 'chevron-right' && <path d="m9 6 6 6-6 6" />}
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'sparkle' && <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3Zm7 12 .8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15Z" />}
  {name === 'layers' && <path d="m12 3 9 5-9 5-9-5 9-5Zm-9 9 9 5 9-5M3 16l9 5 9-5" />}
  {name === 'code' && <path d="m8 7-5 5 5 5m8-10 5 5-5 5M14 4l-4 16" />}
  {name === 'gauge' && <path d="M4.5 16a8 8 0 1 1 15 0M12 13l4-4M12 13a1.5 1.5 0 1 0 0 .1" />}
  {name === 'pen' && <path d="M4 20l4.5-1 10-10a2.1 2.1 0 0 0-3-3l-10 10L4 20Zm10-13 3 3" />}
  {name === 'eye' && <path d="M2.5 12S6 5 12 5s9.5 7 9.5 7-3.5 7-9.5 7-9.5-7-9.5-7Zm9.5 3a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />}
  {name === 'wave' && <path d="M3 15c2.5 0 2.5-6 5-6s2.5 6 5 6 2.5-6 5-6 2.5 3 3 3" />}
  {name === 'grid' && <path d="M4 4h6v6H4V4Zm10 0h6v6h-6V4ZM4 14h6v6H4v-6Zm10 0h6v6h-6v-6Z" />}
  {name === 'devices' && <path d="M3 6a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v2M3 6v8a2 2 0 0 0 2 2h7M14 10h6a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1h-6a1 1 0 0 1-1-1v-8a1 1 0 0 1 1-1Z" />}
  {name === 'map-pin' && <path d="M12 21s-7-6-7-11.5a7 7 0 0 1 14 0C19 15 12 21 12 21Zm0-9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" />}
  {name === 'mail' && <path d="M4 6h16v12H4V6Zm0 1 8 6 8-6" />}
  {name === 'chat' && <path d="M21 12a8.5 7.5 0 0 1-12.5 6.6L4 20l1.3-3.6A7.3 7.3 0 0 1 3.5 12 8.5 7.5 0 0 1 21 12Z" />}
  {name === 'rocket' && <path d="M14 4c3 0 6 3 6 6l-6 6-6-6 6-6Zm-6 6-3 1-2 3 4 1m4 4 1 4 3-2 1-3M14.5 9.5h.01" />}
  {name === 'refresh' && <path d="M20 11a8 8 0 0 0-14.6-4M4 4v4h4m-4 5a8 8 0 0 0 14.6 4M20 20v-4h-4" />}
  {name === 'target' && <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-4a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0-4a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" />}
  {name === 'shield' && <path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.3 7.5 9.5 4.3-1.2 7.5-4.9 7.5-9.5V6L12 3Zm-3.5 9 2.5 2.5 4.5-5" />}
  {name === 'wrench' && <path d="M14.5 6.5a4 4 0 0 0 5 5L12 19a2.1 2.1 0 0 1-3-3l7.5-7.5a4 4 0 0 1-2-2Z" />}
  {name === 'palette' && <path d="M12 3a9 9 0 0 0 0 18c1.5 0 2-1 2-2s-1-1.5-1-2.5S14 15 15 15h2a4 4 0 0 0 4-4c0-4.4-4-8-9-8ZM7.5 11h.01M10 7.5h.01M14.5 7.5h.01" />}
  {name === 'utensils' && <path d="M6 3v8m3-8v5a3 3 0 0 1-6 0V3m3 8v10M17 3c-2 2-2.5 4.5-2.5 7.5H18V21M18 3v18" />}
  {name === 'hammer' && <path d="M13 6 9 2 4 7l4 4m5-5 3-1 4 4-1 3-6 6-5-5m-1 1-5 5 2 2 5-5" />}
  {name === 'home' && <path d="M3 11 12 4l9 7M5 10v10h5v-6h4v6h5V10" />}
  {name === 'camera' && <path d="M4 8h3l2-3h6l2 3h3v11H4V8Zm8 9a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />}
  {name === 'bag' && <path d="M5 8h14l-1 12H6L5 8Zm4 0V6a3 3 0 0 1 6 0v2" />}
  {name === 'bolt' && <path d="M13 3 5 13h6l-1 8 8-10h-6l1-8Z" />}
</svg>
