---
// Intro nach Referenzvideo (ca. 2,5 s):
//  0,0–0,8 s  Ring mit Punkt dreht sich, öffnet sich und wird zum Oliven-Logo
//  0,9–1,6 s  Wortmarke klappt rechts auf (Logo rutscht nach links), Buchstaben einzeln aus der Unschärfe
//  1,6–2,0 s  Marke wird leicht größer
//  1,95–2,55 s Vorhang: die dunkle Seite schiebt sich von unten nach oben ins Bild
// Reines CSS. Nur beim ersten Besuch je Sitzung, bei reduzierter Bewegung ausgeblendet.
import { Image } from 'astro:assets';
import olive from '../assets/brand/logo-olive.png';

const letters = 'BLUE OLIVE LAB'.split('');
---

<div class="intro" aria-hidden="true">
  <div class="intro-group">
    <span class="intro-mark">
      <svg class="intro-ring" viewBox="0 0 100 100" fill="none">
        <circle class="ring" cx="50" cy="50" r="40" stroke="currentColor" stroke-width="9" pathLength="100" />
        <circle class="dot" cx="50" cy="50" r="22" fill="currentColor" />
      </svg>
      <Image src={olive} alt="" widths={[96, 192]} sizes="96px" width={96} height={96} loading="eager" class="intro-logo" />
    </span>
    <span class="intro-word">
      <span class="intro-word-inner">
        {letters.map((ch, i) => <span style={`--i:${i}`}>{ch === ' ' ? ' ' : ch}</span>)}
      </span>
    </span>
  </div>
</div>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: #0d1b26;
    color: #fff;
    pointer-events: none;
    animation: intro-wipe 0.6s cubic-bezier(0.76, 0, 0.24, 1) 1.95s forwards;
  }
  :global(html.intro-seen) .intro {
    display: none;
  }
  .intro-group {
    display: flex;
    align-items: center;
    animation: intro-grow 0.45s var(--ease-out-soft) 1.6s both;
  }
  .intro-mark {
    position: relative;
    display: grid;
    width: clamp(3.25rem, 7vw, 5rem);
    aspect-ratio: 1;
    flex: none;
  }
  .intro-ring,
  .intro-logo {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
  }
  .intro-ring {
    animation: ring-spin 0.8s cubic-bezier(0.65, 0, 0.35, 1) both;
  }
  .ring {
    stroke-dasharray: 100 0;
    animation: ring-open 0.6s cubic-bezier(0.65, 0, 0.35, 1) 0.15s both;
    transform-origin: 50% 50%;
  }
  .dot {
    transform-origin: 50% 50%;
    animation: dot-shrink 0.6s cubic-bezier(0.65, 0, 0.35, 1) 0.15s both;
  }
  .intro-logo {
    opacity: 0;
    transform: scale(0.7) rotate(-25deg);
    filter: drop-shadow(0 0 24px rgb(56 189 248 / 0.45));
    animation: logo-in 0.45s var(--ease-out-soft) 0.55s forwards;
  }
  /* Wortmarke klappt auf: Raster 0fr → 1fr (animierbar), das Logo rutscht dadurch nach links */
  .intro-word {
    display: grid;
    grid-template-columns: 0fr;
    animation: word-open 0.75s cubic-bezier(0.65, 0, 0.35, 1) 0.9s forwards;
  }
  .intro-word-inner {
    display: flex;
    min-width: 0;
    overflow: hidden;
    padding-left: 0.85rem;
    font-size: clamp(1.35rem, 0.9rem + 2.6vw, 2.6rem);
    font-weight: 700;
    letter-spacing: 0.16em;
    white-space: nowrap;
  }
  .intro-word-inner span {
    opacity: 0;
    filter: blur(8px);
    color: #8aa3b4;
    animation: letter-in 0.5s var(--ease-out-soft) forwards;
    animation-delay: calc(1s + var(--i) * 0.055s);
  }
  @keyframes ring-spin {
    from {
      transform: rotate(-120deg) scale(0.85);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    to {
      transform: rotate(160deg) scale(1);
      opacity: 1;
    }
  }
  @keyframes ring-open {
    to {
      stroke-dasharray: 62 38;
      opacity: 0;
    }
  }
  @keyframes dot-shrink {
    60% {
      transform: scale(0.55);
      opacity: 1;
    }
    to {
      transform: scale(0.3);
      opacity: 0;
    }
  }
  @keyframes logo-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes word-open {
    to {
      grid-template-columns: 1fr;
    }
  }
  @keyframes letter-in {
    to {
      opacity: 1;
      filter: blur(0);
      color: #fff;
    }
  }
  @keyframes intro-grow {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.12);
    }
  }
  /* Vorhang: untere Kante der Intro-Fläche wandert nach oben */
  @keyframes intro-wipe {
    from {
      clip-path: inset(0 0 0 0);
    }
    to {
      clip-path: inset(0 0 100% 0);
      visibility: hidden;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .intro {
      display: none;
    }
  }
</style>
