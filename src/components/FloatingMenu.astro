---
// Floating Menu Button – nur Handy & Tablet (Variante "touch"), hoch und quer.
// Kreis wächst aus dem Knopf, Menüpunkte schweben gestaffelt herein, Burger wird zum X.
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { cta, nav, site } from '../data/site';
---

<button type="button" class="fab hidden touch:grid" aria-label="Menü öffnen" aria-controls="fab-menu" aria-expanded="false" data-fab-open>
  <span class="fab-lines" aria-hidden="true"><span></span><span></span><span></span></span>
</button>

<dialog id="fab-menu" class="fab-menu" aria-label="Menü">
  <div class="fab-menu-bg" aria-hidden="true"></div>
  <div class="fab-menu-content">
    <a href="#top" class="fab-item inline-flex self-start" style="--i: 0" data-close>
      <Logo size={36} />
    </a>
    <nav aria-label="Mobile Navigation" class="fab-nav">
      <ul class="fab-list">
        {
          nav.map((item, i) => (
            <li class="fab-item" style={`--i: ${i + 1}`}>
              <a href={item.href} class="fab-link" data-close>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="fab-item fab-footer" style={`--i: ${nav.length + 1}`}>
      <a href={cta.href} class="btn btn-primary" data-close>
        {cta.label}
        <Icon name="arrow-right" size={16} />
      </a>
      <a href={`mailto:${site.email}`} class="btn btn-soft">
        <Icon name="mail" size={16} />
        E-Mail
      </a>
      <p class="w-full text-xs text-paper-mute">{site.name} · {site.city}</p>
    </div>
  </div>
  <button type="button" class="fab grid" aria-label="Menü schließen" data-fab-close>
    <span class="fab-lines" aria-hidden="true"><span></span><span></span><span></span></span>
  </button>
</dialog>

<style>
  .fab {
    position: fixed;
    z-index: 55;
    right: calc(1rem + env(safe-area-inset-right));
    bottom: calc(1rem + env(safe-area-inset-bottom));
    width: 3.5rem;
    height: 3.5rem;
    place-items: center;
    border-radius: 999px;
    background: var(--color-olive);
    color: var(--color-ink);
    box-shadow: 0 12px 30px -10px rgb(14 165 233 / 0.7);
    transition: transform 0.25s var(--ease-out-soft);
    -webkit-tap-highlight-color: transparent;
  }
  .fab:active {
    transform: scale(0.92);
  }
  .fab-lines {
    position: relative;
    display: block;
    width: 22px;
    height: 16px;
  }
  .fab-lines span {
    position: absolute;
    right: 0;
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transform-origin: right center;
    transition:
      transform 0.45s var(--ease-out-soft),
      opacity 0.2s ease;
  }
  .fab-lines span:nth-child(1) {
    top: 0;
  }
  .fab-lines span:nth-child(2) {
    top: 7px;
    transform: scaleX(0.64);
  }
  .fab-lines span:nth-child(3) {
    top: 14px;
    transform: scaleX(0.82);
  }
  .fab-menu[data-state='open'] .fab-lines span {
    transform-origin: center;
  }
  .fab-menu[data-state='open'] .fab-lines span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .fab-menu[data-state='open'] .fab-lines span:nth-child(2) {
    transform: scaleX(0);
    opacity: 0;
  }
  .fab-menu[data-state='open'] .fab-lines span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  .fab-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
    overflow: hidden;
  }
  .fab-menu::backdrop {
    background: transparent;
  }
  .fab-menu-bg {
    --d: 300vmax;
    position: fixed;
    width: var(--d);
    height: var(--d);
    right: calc(1rem + env(safe-area-inset-right) + 1.75rem - var(--d) / 2);
    bottom: calc(1rem + env(safe-area-inset-bottom) + 1.75rem - var(--d) / 2);
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 50%, rgb(14 165 233 / 0.16), transparent 9%),
      var(--color-ink);
    transform: scale(0);
    transition: transform 0.65s cubic-bezier(0.7, 0, 0.2, 1);
  }
  .fab-menu[data-state='open'] .fab-menu-bg {
    transform: scale(1);
  }
  .fab-menu[data-state='closing'] .fab-menu-bg {
    transition-duration: 0.5s;
    transition-delay: 0.08s;
  }
  .fab-menu-content {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    height: 100%;
    overflow-y: auto;
    padding: calc(1rem + env(safe-area-inset-top)) 1.5rem calc(6rem + env(safe-area-inset-bottom));
  }
  .fab-nav {
    margin-block: auto;
  }
  .fab-list {
    display: grid;
    gap: 0.5rem;
  }
  .fab-link {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    font-size: clamp(1.75rem, 1.2rem + 2.6vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    transition: color 0.2s ease;
  }
  .fab-link:hover {
    color: var(--color-olive-bright);
  }
  .fab-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .fab-item {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.35s ease,
      transform 0.55s var(--ease-out-soft);
    transition-delay: calc(var(--i) * 60ms + 220ms);
  }
  .fab-menu[data-state='open'] .fab-item {
    opacity: 1;
    transform: none;
  }
  .fab-menu[data-state='closing'] .fab-item {
    transition-duration: 0.18s;
    transition-delay: 0ms;
  }
  @media (width >= 48rem) {
    .fab-menu-content {
      padding-inline: 3rem;
    }
  }
  @media (orientation: landscape) and (max-height: 32rem) {
    .fab-menu-content {
      gap: 0.75rem;
      padding-top: calc(0.75rem + env(safe-area-inset-top));
      padding-bottom: calc(1rem + env(safe-area-inset-bottom));
    }
    .fab-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 2rem;
    }
    .fab-link {
      min-height: 2.75rem;
      font-size: 1.4rem;
    }
    .fab-footer {
      padding-right: 5rem;
    }
  }
</style>

<script>
  const dialog = document.getElementById('fab-menu') as HTMLDialogElement | null;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-fab-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-fab-close]');
  if (dialog && openBtn && closeBtn) {
    const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer = 0;
    const finish = () => {
      dialog.close();
      dialog.removeAttribute('data-state');
      document.documentElement.style.overflow = '';
      openBtn.setAttribute('aria-expanded', 'false');
    };
    const open = () => {
      window.clearTimeout(timer);
      dialog.showModal();
      dialog.querySelector<HTMLElement>('.fab-link')?.focus({ preventScroll: true });
      document.documentElement.style.overflow = 'hidden';
      openBtn.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => requestAnimationFrame(() => dialog.setAttribute('data-state', 'open')));
    };
    const close = (restoreFocus = true) => {
      if (!dialog.open || dialog.getAttribute('data-state') === 'closing') return;
      dialog.setAttribute('data-state', 'closing');
      timer = window.setTimeout(
        () => {
          finish();
          if (restoreFocus) openBtn.focus();
        },
        reduced() ? 0 : 600,
      );
    };
    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', () => close());
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
    // Anker-Links: Menü schließen, Scroll-Sperre lösen, dann gezielt zum Abschnitt springen
    dialog.querySelectorAll<HTMLAnchorElement>('a[data-close]').forEach((a) =>
      a.addEventListener('click', (e) => {
        const hash = a.getAttribute('href') ?? '';
        const target = hash.startsWith('#') ? document.querySelector<HTMLElement>(hash) : null;
        window.clearTimeout(timer);
        finish();
        if (!target) return;
        e.preventDefault();
        requestAnimationFrame(() => {
          target.scrollIntoView({ behavior: reduced() ? 'auto' : 'smooth', block: 'start' });
          history.pushState(null, '', hash);
        });
      }),
    );
    window.addEventListener('pageshow', (e) => {
      if (e.persisted && dialog.open) finish();
    });
  }
</script>
