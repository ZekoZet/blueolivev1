---
import Words from './Words.astro';
import Icon from './Icon.astro';
import { pricing } from '../data/site';

const eur = (n: number) => new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n);
---

<section id="preise" class="on-dark relative isolate bg-ink py-20 md:py-28" data-pricing>
  <div class="container-page">
    <div class="text-center">
      <div class="inline-flex gap-1 rounded-full border border-white/10 bg-white/5 p-1" role="group" aria-label="Preisansicht" data-anim="fade">
        {
          pricing.modes.map((m, i) => (
            <button
              type="button"
              class="min-h-10 rounded-full px-4 text-sm font-semibold text-paper-soft transition-colors aria-pressed:bg-paper aria-pressed:text-ink"
              aria-pressed={i === 0 ? 'true' : 'false'}
              data-mode={i}
            >
              {m}
            </button>
          ))
        }
      </div>
      <h2 class="h2 mx-auto mt-6 max-w-3xl" data-anim="words"><Words text={pricing.title} /></h2>
    </div>

    <ul class="mt-12 grid items-stretch gap-4 lg:grid-cols-3" data-anim="stagger" style="--delay:300ms;--step:140ms">
      {
        pricing.plans.map((plan) => (
          <li class:list={['card-dark flex flex-col p-6', plan.featured && 'featured lg:-translate-y-3']}>
            <p class="text-center text-xs font-semibold tracking-wide text-paper-mute uppercase">{plan.name}</p>
            <p class="mt-3 text-center">
              <span class="text-4xl font-bold tracking-tight">ab {eur(plan.price[0] ?? 0)}</span>
            </p>
            <p class="mt-1 h-5 text-center text-xs text-paper-soft" aria-live="polite">
              {plan.monthly.map((m, i) => (
                <span data-mode-text={i} hidden={i !== 0}>
                  {m > 0 ? `+ ${eur(m)} / Monat Betreuung` : 'einmaliger Festpreis'}
                </span>
              ))}
            </p>
            <ul class="mt-6 space-y-3 border-t border-white/8 pt-6 text-sm text-paper-soft">
              {plan.features.map((f) => (
                <li class="flex gap-2.5">
                  <Icon name="check" size={18} class="shrink-0 text-olive-bright" />
                  {f}
                </li>
              ))}
            </ul>
            <a href="#kontakt" class:list={['btn mt-8 w-full', plan.featured ? 'btn-primary' : 'btn-soft']}>
              {pricing.button}
              <span class="sr-only">: {plan.name}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-8 space-y-1 text-center text-xs text-paper-soft" data-anim="fade" style="--delay:500ms">
      {pricing.notes.map((n) => <p>{n}</p>)}
    </div>
  </div>
</section>

<style>
  .featured {
    border-color: rgb(56 189 248 / 0.35);
    box-shadow:
      0 0 0 1px rgb(56 189 248 / 0.15),
      0 30px 80px -30px rgb(14 165 233 / 0.55);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-pricing]');
  root?.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.dataset.mode;
      root.querySelectorAll('[data-mode]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      root.querySelectorAll<HTMLElement>('[data-mode-text]').forEach((el) => (el.hidden = el.dataset.modeText !== mode));
    });
  });
</script>
