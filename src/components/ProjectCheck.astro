---
import Words from './Words.astro';
import { Image } from 'astro:assets';
import olive from '../assets/brand/logo-olive.png';
import Icon, { type IconName } from './Icon.astro';
import { projectCheck, site } from '../data/site';

const stepIcons: IconName[] = ['chat', 'pen', 'code', 'rocket'];
const stepTones = ['bg-emerald-100 text-emerald-700', 'bg-amber-100 text-amber-700', 'bg-sky-100 text-sky-700', 'bg-violet-100 text-violet-700'];
---

<section id="projekt" data-stack class="on-light relative bg-[linear-gradient(180deg,#fff,var(--color-light))] py-20 text-light-text md:py-28">
  <div class="container-page text-center">
    <div class="flex items-center justify-center gap-4" data-anim="lines">
      <span class="line line-l hidden h-px w-24 bg-[repeating-linear-gradient(90deg,var(--color-light-line)_0_6px,transparent_6px_12px)] sm:block" aria-hidden="true"></span>
      <p class="badge">{projectCheck.badge}</p>
      <span class="line line-r hidden h-px w-24 bg-[repeating-linear-gradient(90deg,var(--color-light-line)_0_6px,transparent_6px_12px)] sm:block" aria-hidden="true"></span>
    </div>
    <h2 class="h2 mt-5" data-anim="words"><Words text={projectCheck.title} /></h2>
    <p class="lead mx-auto mt-3 max-w-xl" data-anim="fade" style="--delay:600ms">{projectCheck.text}</p>

    <ul class="mx-auto mt-6 flex w-fit flex-wrap justify-center gap-2 p-1" aria-label="Eingesetzte Werkzeuge" data-anim="expand" style="--delay:800ms">
      {projectCheck.tags.map((t, i) => <li style={`--si:${i}`} class="rounded-lg border border-light-line bg-white px-2.5 py-1 text-xs font-semibold text-light-mute">{t}</li>)}
    </ul>

    <div class="card-light mx-auto mt-10 max-w-4xl overflow-hidden text-left" data-anim="rise" style="--delay:300ms">
      <div class="relative overflow-hidden px-6 pt-10 pb-6 text-center md:px-10">
        <div class="arc absolute top-6 left-1/2 aspect-square w-72 -translate-x-1/2 rounded-full" aria-hidden="true"></div>
        <div class="relative" data-later style="--later:800ms">
          <span class="mx-auto grid size-12 place-items-center rounded-xl bg-ink shadow-lg">
            <Image src={olive} alt="" widths={[32, 64]} sizes="32px" width={32} height={32} class="size-8" />
          </span>
          <h3 class="mt-4 text-2xl font-semibold tracking-tight">{projectCheck.cardTitle}</h3>
        </div>
      </div>

      <ol class="grid gap-x-10 gap-y-5 px-6 md:grid-cols-2 md:px-10" data-later style="--later:1100ms">
        {
          projectCheck.steps.map((s, i) => (
            <li class="flex gap-3">
              <span class:list={['grid size-9 shrink-0 place-items-center rounded-lg', stepTones[i]]}>
                <Icon name={stepIcons[i] ?? 'check'} size={18} />
              </span>
              <span>
                <span class="block text-sm font-semibold">{s.title}</span>
                <span class="block text-sm text-light-mute">{s.text}</span>
              </span>
            </li>
          ))
        }
      </ol>

      <form data-later style="--later:1400ms" class="mx-6 mt-8 flex items-center gap-2 rounded-2xl border border-light-line bg-light p-2 pl-4 md:mx-10" data-project-form>
        <label for="project-line" class="sr-only">{projectCheck.placeholder}</label>
        <input
          id="project-line"
          name="projekt"
          type="text"
          required
          maxlength="240"
          placeholder={projectCheck.placeholder}
          class="min-h-11 flex-1 bg-transparent text-sm text-light-text outline-none placeholder:text-light-mute"
        />
        <button type="submit" class="grid size-11 shrink-0 place-items-center rounded-xl bg-ink text-paper transition-colors hover:bg-olive-deep" aria-label="Projektanfrage per E-Mail öffnen">
          <Icon name="arrow-up" size={18} />
        </button>
      </form>
      <p class="px-6 pt-3 pb-8 text-center text-xs text-light-mute md:px-10">{projectCheck.note}</p>
    </div>
  </div>
</section>

<style>
  .arc {
    background: radial-gradient(circle at 50% 30%, #d6efff 0%, #eef8ff 45%, transparent 70%);
  }
</style>

<script define:vars={{ email: site.email }}>
  const form = document.querySelector('[data-project-form]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const text = new FormData(form).get('projekt')?.toString().trim() ?? '';
    if (!text) return;
    const subject = encodeURIComponent('Projektanfrage über blue-olive.online');
    window.location.href = `mailto:${email}?subject=${subject}&body=${encodeURIComponent(text)}`;
  });
</script>
