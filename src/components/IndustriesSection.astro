---
import Words from './Words.astro';
import Icon, { type IconName } from './Icon.astro';
import { industries } from '../data/site';

const icons: Record<string, IconName> = {
  gastro: 'utensils',
  craft: 'hammer',
  estate: 'home',
  creative: 'camera',
  retail: 'bag',
  startup: 'rocket',
};
---

<section id="branchen" data-stack class="on-light relative bg-white py-20 text-light-text md:py-28">
  <div class="container-page">
    <div class="text-center">
      <p class="badge" data-anim="fade">{industries.badge}</p>
      <h2 class="h2 mx-auto mt-5 max-w-3xl" data-anim="words"><Words text={industries.title} /></h2>
    </div>

    <ul class="mt-12 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3" data-anim="stagger" style="--step:120ms">
      {
        industries.items.map((item) => (
          <li>
            <div class="illu relative grid h-36 place-items-center overflow-hidden rounded-[var(--radius-card)] border border-light-line bg-light" aria-hidden="true">
              {item.key === 'gastro' && (
                <>
                  <span class="pin" style="left:28%;top:34%" />
                  <span class="pin" style="left:62%;top:22%" />
                  <span class="pin" style="left:74%;top:58%" />
                </>
              )}
              {item.key === 'craft' && (
                <span class="flex gap-2">
                  {[0, 1, 2].map((n) => (
                    <span class="h-16 w-12 rounded-lg border border-light-line bg-white shadow-sm" style={`transform:translateY(${n * -6}px)`} />
                  ))}
                </span>
              )}
              {item.key === 'creative' && (
                <span class="grid grid-cols-3 gap-1.5">
                  {[0, 1, 2, 3, 4, 5].map((n) => (
                    <span class:list={['size-9 rounded-md', n === 4 ? 'bg-olive-deep/80' : 'bg-white border border-light-line']} />
                  ))}
                </span>
              )}
              {item.key === 'retail' && (
                <span class="flex items-end gap-2">
                  {[40, 64, 52, 80].map((h) => (
                    <span class="w-7 rounded-t-md bg-olive-deep/70" style={`height:${h}px`} />
                  ))}
                </span>
              )}
              {item.key === 'startup' && (
                <span class="relative h-20 w-40 rounded-xl border border-light-line bg-white shadow-sm">
                  <span class="absolute top-3 left-3 h-2 w-16 rounded bg-light-line" />
                  <span class="absolute top-7 left-3 h-2 w-24 rounded bg-light-line" />
                  <span class="absolute bottom-3 left-3 h-5 w-14 rounded-full bg-olive-deep" />
                </span>
              )}
              <span class="absolute right-4 bottom-4 grid size-11 place-items-center rounded-xl bg-white text-olive-deep shadow-sm">
                <Icon name={icons[item.key] ?? 'sparkle'} size={20} />
              </span>
            </div>
            <h3 class="mt-5 text-lg font-semibold">{item.title}</h3>
            <ul class="mt-3 space-y-1.5 text-sm text-light-mute">
              {item.points.map((p) => (
                <li class="flex gap-2">
                  <span class="mt-2 size-1.5 shrink-0 rounded-full bg-light-mute" aria-hidden="true" />
                  {p}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .pin {
    position: absolute;
    width: 18px;
    height: 18px;
    border-radius: 50% 50% 50% 0;
    background: var(--color-olive-deep);
    transform: rotate(-45deg);
    box-shadow: 0 6px 14px -4px rgb(3 105 161 / 0.6);
  }
  .pin::after {
    content: '';
    position: absolute;
    inset: 5px;
    border-radius: 50%;
    background: #fff;
  }
  .illu {
    background-image:
      linear-gradient(to right, var(--color-light-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-light-line) 1px, transparent 1px);
    background-size: 28px 28px;
    background-color: var(--color-light);
  }
</style>
